meta(
    name: "StoneMarker",
    version: 1.0.0,
    author: "Salmon Examples"
)

# Places a small marker in the loaded world named "world".
# Change the coordinates and world name before use. Block edits can generate
# chunks and apply normal Minecraft block physics.
local x = 0
local y = 64
local z = 0
local worldName = "world"

setBlock("minecraft:stone", x, y, z, worldName)
setBlock("minecraft:torch", x, y + 1, z, worldName)
print("Placed a stone marker at " .. tostring(x) .. " " .. tostring(y) .. " " .. tostring(z))
