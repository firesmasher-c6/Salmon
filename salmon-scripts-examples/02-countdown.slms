meta(
    name: "Countdown",
    version: 1.0.0,
    author: "Salmon Examples"
)

# Demonstrates numeric loops, conditionals, string conversion, and wait().
for number = 3, 1, -1 do
    print("Countdown: " .. tostring(number))
    command("say Countdown: " .. tostring(number))
    wait(20)
end

print("Countdown complete.")
